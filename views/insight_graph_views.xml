<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Append insight_graph to each action's view_mode ─────────────── -->
        <record id="base.action_partner_form" model="ir.actions.act_window">
            <field name="view_mode">kanban,tree,form,insight_graph</field>
        </record>

        <record id="contacts.action_contacts" model="ir.actions.act_window">
            <field name="view_mode">kanban,tree,form,activity,insight_graph</field>
        </record>

        <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
            <field name="view_mode">list,kanban,form,insight_graph</field>
        </record>

        <!-- ── insight_graph view: res.partner ────────────────────────────── -->
        <record id="view_res_partner_insight_graph" model="ir.ui.view">
            <field name="name">res.partner.insight_graph</field>
            <field name="model">res.partner</field>
            <field name="type">insight_graph</field>
            <field name="arch" type="xml">
                <insight_graph>
                    <node shape="roundrectangle">
                        <field name="display_name" primary="true"/>
                        <field name="vat"/>
                        <field name="image_128" type="image"/>
                    </node>
                    <link field="parent_id"   direction="upstream"   model="res.partner"/>
                    <link field="child_ids"   direction="downstream" model="res.partner"/>
                    <link field="invoice_ids" direction="downstream" model="account.move"/>
                </insight_graph>
            </field>
        </record>

        <record id="act_view_res_partner_insight_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="99"/>
            <field name="view_mode">insight_graph</field>
            <field name="view_id" ref="view_res_partner_insight_graph"/>
            <field name="act_window_id" ref="base.action_partner_form"/>
        </record>

        <record id="act_view_contacts_insight_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="99"/>
            <field name="view_mode">insight_graph</field>
            <field name="view_id" ref="view_res_partner_insight_graph"/>
            <field name="act_window_id" ref="contacts.action_contacts"/>
        </record>

        <!-- ── insight_graph view: account.move (facturas) ───────────────── -->
        <record id="view_account_move_insight_graph" model="ir.ui.view">
            <field name="name">account.move.insight_graph</field>
            <field name="model">account.move</field>
            <field name="type">insight_graph</field>
            <field name="arch" type="xml">
                <insight_graph>
                    <node shape="rectangle">
                        <field name="name" primary="true"/>
                        <field name="move_type"/>
                        <field name="state" color="true"/>
                    </node>
                    <link field="partner_id"  direction="upstream"   model="res.partner"/>
                    <link field="product_ids" direction="downstream" model="product.product"/>
                </insight_graph>
            </field>
        </record>

        <record id="act_view_account_move_insight_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="99"/>
            <field name="view_mode">insight_graph</field>
            <field name="view_id" ref="view_account_move_insight_graph"/>
            <field name="act_window_id" ref="account.action_move_out_invoice_type"/>
        </record>

        <!-- ── insight_graph view: product.product ───────────────────────── -->
        <record id="view_product_product_insight_graph" model="ir.ui.view">
            <field name="name">product.product.insight_graph</field>
            <field name="model">product.product</field>
            <field name="type">insight_graph</field>
            <field name="arch" type="xml">
                <insight_graph>
                    <node shape="diamond">
                        <field name="display_name" primary="true"/>
                        <field name="categ_id"/>
                    </node>
                </insight_graph>
            </field>
        </record>

    </data>
</odoo>
