<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Categoría de producto ──────────────────────────────────────── -->
        <record id="demo_categ_music" model="product.category">
            <field name="name">Instrumentos Musicales</field>
        </record>

        <!-- ── Productos ──────────────────────────────────────────────────── -->
        <record id="demo_product_guitar" model="product.product">
            <field name="name">Guitarra Fender Stratocaster</field>
            <field name="detailed_type">service</field>
            <field name="list_price">1500.0</field>
            <field name="categ_id" ref="demo_categ_music"/>
        </record>

        <record id="demo_product_mic" model="product.product">
            <field name="name">Micrófono Shure SM58</field>
            <field name="detailed_type">service</field>
            <field name="list_price">250.0</field>
            <field name="categ_id" ref="demo_categ_music"/>
        </record>

        <!-- ── Partners — Compositores ────────────────────────────────────── -->
        <record id="demo_partner_piazzolla" model="res.partner">
